# dqvouch reads these from the environment or from a .env file in the folder you start it from.
# `dqvouch ui` saves them there for you (a private file); never commit .env.
GEMINI_API_KEY=
# Only for an OpenAI-compatible server that asks for a key ([llm] provider = "openai"):
OPENAI_API_KEY=
DQVOUCH_DB_PASSWORD=

# Alerts when a test starts failing (both optional; set them on the Results screen or here).
DQVOUCH_ALERT_WEBHOOK_URL=
DQVOUCH_SMTP_HOST=
DQVOUCH_SMTP_PORT=587
DQVOUCH_SMTP_USER=
DQVOUCH_SMTP_PASSWORD=
DQVOUCH_SMTP_FROM=
DQVOUCH_SMTP_TO=
